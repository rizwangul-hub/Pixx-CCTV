PORT=5000
NODE_ENV=development
ADMIN_API_KEY=your_secure_admin_api_key_here

# Snapshot Storage & Retention
SNAPSHOT_STORAGE_DIR=storage/snapshots
SNAPSHOT_RETENTION_HOURS=72

